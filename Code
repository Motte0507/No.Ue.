function stars(value) {
    return "★".repeat(value) + "☆".repeat(5 - value);
}

function render() {

    const grid = document.getElementById("grid");
    const search = document.getElementById("search").value.toLowerCase();
    const category = document.getElementById("category").value;
    const sort = document.getElementById("sort").value;

    let filtered = investments.filter(item => {

        const matchesSearch =
            item.name.toLowerCase().includes(search) ||
            item.type.toLowerCase().includes(search);

        const matchesCategory =
            category === "all" || item.category === category;

        return matchesSearch && matchesCategory;
    });

    if (sort !== "none") {
        filtered.sort((a,b) => b[sort] - a[sort]);
    }

    grid.innerHTML = "";

    filtered.forEach((item, index) => {

        const card = document.createElement("div");
        card.className = "card";

        card.innerHTML = `
            <span class="badge">${item.type}</span>
            <h2>${item.name}</h2>

            <div class="rating">
                Rendite:
                <span class="stars">${stars(item.return)}</span>
            </div>

            <div class="rating">
                Sicherheit:
                <span class="stars">${stars(item.safety)}</span>
            </div>

            <div class="rating">
                Verfügbarkeit:
                <span class="stars">${stars(item.availability)}</span>
            </div>
        `;

        card.onclick = () => openModal(item);

        grid.appendChild(card);
    });
}

function openModal(item) {

    const modal = document.getElementById("modal");
    const content = document.getElementById("modalContent");

    content.innerHTML = `
        <span class="badge">${item.type}</span>

        <h2>${item.name}</h2>

        <p>${item.description}</p>

        <h3 class="pros">Vorteile</h3>
        <ul>
            ${item.pros.map(x => `<li>${x}</li>`).join("")}
        </ul>

        <h3 class="cons">Nachteile</h3>
        <ul>
            ${item.cons.map(x => `<li>${x}</li>`).join("")}
        </ul>

        <h3>Bewertung</h3>

        <p>
            Rendite:
            <span class="stars">${stars(item.return)}</span>
        </p>

        <p>
            Sicherheit:
            <span class="stars">${stars(item.safety)}</span>
        </p>

        <p>
            Verfügbarkeit:
            <span class="stars">${stars(item.availability)}</span>
        </p>
    `;

    modal.style.display = "block";
}

function closeModal() {
    document.getElementById("modal").style.display = "none";
}

window.onclick = function(event) {

    const modal = document.getElementById("modal");

    if (event.target === modal) {
        closeModal();
    }
};

document.getElementById("search").addEventListener("input", render);
document.getElementById("category").addEventListener("change", render);
document.getElementById("sort").addEventListener("change", render);

render();

</script>

