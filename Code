<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Anlageformen</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #f4f7fb;
    color: #172033;
}

header {
    background: linear-gradient(135deg, #0b3d91, #1769d1);
    color: white;
    padding: 45px 20px;
    text-align: center;
}

header h1 {
    margin: 0 0 10px;
    font-size: 42px;
}

header p {
    margin: 0;
    font-size: 18px;
    opacity: 0.9;
}

.controls {
    max-width: 1200px;
    margin: 25px auto;
    padding: 0 20px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

input, select {
    padding: 13px 15px;
    border: 1px solid #ccd5e3;
    border-radius: 10px;
    font-size: 15px;
    background: white;
}

input {
    flex: 1;
    min-width: 220px;
}

select {
    min-width: 180px;
}

.grid {
    max-width: 1200px;
    margin: 30px auto 60px;
    padding: 0 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
}

.card {
    background: white;
    border-radius: 16px;
    padding: 22px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    cursor: pointer;
    transition: 0.2s;
    border: 1px solid #e5eaf1;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.13);
}

.card h2 {
    margin-top: 0;
    color: #0b3d91;
}

.badge {
    display: inline-block;
    background: #e8f0ff;
    color: #0b3d91;
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 12px;
    margin-bottom: 12px;
}

.stars {
    color: #f5b400;
    letter-spacing: 2px;
}

.rating {
    margin-top: 12px;
    font-size: 14px;
}

.modal {
    display: none;
    position: fixed;
    z-index: 10;
    inset: 0;
    background: rgba(0,0,0,0.6);
    padding: 20px;
    overflow-y: auto;
}

.modal-content {
    max-width: 700px;
    margin: 60px auto;
    background: white;
    border-radius: 18px;
    padding: 30px;
    position: relative;
}

.close {
    position: absolute;
    right: 22px;
    top: 15px;
    font-size: 30px;
    cursor: pointer;
    color: #555;
}

.modal h2 {
    color: #0b3d91;
}

.pros {
    color: #16833b;
}

.cons {
    color: #c62828;
}

footer {
    text-align: center;
    padding: 30px 20px;
    background: #172033;
    color: white;
    font-size: 13px;
}

@media (max-width: 600px) {
    header h1 {
        font-size: 32px;
    }
}
</style>
</head>

<body>

<header>
    <h1>Anlageformen</h1>
    <p>Ein Überblick über verschiedene Möglichkeiten der Geldanlage</p>
</header>

<div class="controls">
    <input type="text" id="search" placeholder="Anlageform suchen...">

    <select id="category">
        <option value="all">Alle Kategorien</option>
        <option value="index">Indizes</option>
        <option value="fund">Fonds & Themen</option>
        <option value="other">Weitere Anlageformen</option>
    </select>

    <select id="sort">
        <option value="none">Sortieren</option>
        <option value="return">Rendite</option>
        <option value="safety">Sicherheit</option>
        <option value="availability">Verfügbarkeit</option>
    </select>
</div>

<div class="grid" id="grid"></div>

<div class="modal" id="modal">
    <div class="modal-content">
        <span class="close" onclick="closeModal()">×</span>
        <div id="modalContent"></div>
    </div>
</div>

<footer>
    Die Bewertungen dienen nur zur vereinfachten Orientierung und stellen keine Anlageberatung dar.
</footer>

